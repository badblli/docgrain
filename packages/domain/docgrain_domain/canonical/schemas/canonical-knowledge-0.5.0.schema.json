          "title": "Dependencies",
          "type": "object"
        },
        "identity_policy_version": {
          "const": "0.2.0",
          "default": "0.2.0",
          "title": "Identity Policy Version",
          "type": "string"
        },
        "mapper_version": {
          "default": "m2a-1",
          "minLength": 1,
          "title": "Mapper Version",
          "type": "string"
        },
        "options": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Options",
          "type": "object"
        },
        "parser": {
          "minLength": 1,
          "title": "Parser",
          "type": "string"
        },
        "parser_version": {
          "minLength": 1,
          "title": "Parser Version",
          "type": "string"
        },
        "schema_version": {
          "const": "0.5.0",
          "default": "0.5.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "parser",
        "parser_version"
