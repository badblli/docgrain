      },
      "required": [
        "id",
        "identity_key",
        "type",
        "label",
        "annotation"
      ],
      "title": "Entity",
      "type": "object"
    },
    "EntityReviewEvent": {
      "additionalProperties": false,
      "properties": {
        "decision_id": {
          "minLength": 1,
