      "title": "EntityReviewEvent",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "locator": {
          "discriminator": {
            "mapping": {
              "artifact_object": "#/$defs/ArtifactObjectLocator",
              "docx_block": "#/$defs/DocxBlockLocator",
              "image_region": "#/$defs/ImageRegionLocator",
              "pdf_page": "#/$defs/PdfPageLocator",
              "spreadsheet_range": "#/$defs/SpreadsheetRangeLocator",
              "text_span": "#/$defs/TextSpanLocator"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/PdfPageLocator"
            },
            {
              "$ref": "#/$defs/DocxBlockLocator"
            },
            {
              "$ref": "#/$defs/TextSpanLocator"
            },
            {
              "$ref": "#/$defs/SpreadsheetRangeLocator"
            },
            {
              "$ref": "#/$defs/ArtifactObjectLocator"
            },
            {
              "$ref": "#/$defs/ImageRegionLocator"
            }
          ],
          "title": "Locator"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        },
        "source_version_id": {
          "minLength": 1,
          "title": "Source Version Id",
          "type": "string"
        }
      },
      "required": [
        "id",
        "source_version_id",
        "locator"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "ImageRegionLocator": {
      "additionalProperties": false,
      "description": "Original encoded image pixels, before EXIF orientation; top-left normalized bbox.",
      "properties": {
        "bbox": {
          "$ref": "#/$defs/NormalizedBox"
        },
        "exif_orientation": {
          "maximum": 8,
          "minimum": 1,
          "title": "Exif Orientation",
          "type": "integer"
        },
        "height_px": {
          "exclusiveMinimum": 0,
          "title": "Height Px",
          "type": "integer"
        },
        "kind": {
          "const": "image_region",
          "default": "image_region",
          "title": "Kind",
          "type": "string"
        },
        "width_px": {
          "exclusiveMinimum": 0,
          "title": "Width Px",
          "type": "integer"
        }
      },
      "required": [
        "width_px",
        "height_px",
        "exif_orientation",
        "bbox"
      ],
      "title": "ImageRegionLocator",
      "type": "object"
    },
    "JsonValue": {},
