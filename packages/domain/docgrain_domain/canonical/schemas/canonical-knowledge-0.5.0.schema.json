{
  "$defs": {
    "Annotation": {
      "additionalProperties": false,
      "properties": {
        "provenance": {
          "$ref": "#/$defs/Provenance"
        },
        "review_status": {
          "default": "unreviewed",
          "enum": [
            "unreviewed",
            "proposed",
            "approved",
            "rejected",
            "overridden"
          ],
          "title": "Review Status",
          "type": "string"
        }
      },
      "required": [
        "provenance"
      ],
      "title": "Annotation",
      "type": "object"
    },
    "ArtifactObjectLocator": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "minLength": 1,
          "title": "Artifact Id",
          "type": "string"
        },
        "kind": {
          "const": "artifact_object",
          "default": "artifact_object",
          "title": "Kind",
          "type": "string"
        },
        "object_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Object Path"
        }
      },
      "required": [
        "artifact_id"
      ],
      "title": "ArtifactObjectLocator",
      "type": "object"
    },
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "byte_size": {
          "minimum": 0,
          "title": "Byte Size",
          "type": "integer"
        },
        "content_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Sha256",
          "type": "string"
        },
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "mime_type": {
          "minLength": 1,
          "title": "Mime Type",
          "type": "string"
        },
        "role": {
          "minLength": 1,
          "title": "Role",
          "type": "string"
        },
        "storage_uri": {
          "minLength": 1,
          "title": "Storage Uri",
          "type": "string"
        }
      },
      "required": [
        "id",
        "role",
        "storage_uri",
        "content_sha256",
        "byte_size",
        "mime_type"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "AssetNode": {
