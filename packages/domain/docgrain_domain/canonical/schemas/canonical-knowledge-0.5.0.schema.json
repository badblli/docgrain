    "DomainRecord": {
      "additionalProperties": false,
      "properties": {
        "annotation": {
          "$ref": "#/$defs/Annotation"
        },
        "entity_ids": {
          "items": {
            "type": "string"
          },
          "title": "Entity Ids",
          "type": "array"
        },
        "field_annotations": {
          "additionalProperties": {
            "$ref": "#/$defs/Annotation"
          },
          "title": "Field Annotations",
          "type": "object"
        },
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "identity_key": {
          "minLength": 1,
          "title": "Identity Key",
          "type": "string"
        },
        "schema_id": {
          "minLength": 1,
          "title": "Schema Id",
          "type": "string"
        },
        "validation": {
          "$ref": "#/$defs/DomainValidationResult"
        },
        "validity": {
          "anyOf": [
            {
              "discriminator": {
                "mapping": {
                  "date_range": "#/$defs/DateRange",
                  "datetime_range": "#/$defs/DatetimeRange"
                },
                "propertyName": "kind"
              },
              "oneOf": [
                {
                  "$ref": "#/$defs/DateRange"
                },
                {
                  "$ref": "#/$defs/DatetimeRange"
                }
              ]
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Validity"
        },
        "values": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Values",
          "type": "object"
        }
      },
      "required": [
        "id",
        "identity_key",
        "schema_id",
        "values",
        "annotation"
      ],
      "title": "DomainRecord",
      "type": "object"
    },
    "DomainSchemaRef": {
      "additionalProperties": false,
      "properties": {
        "content_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Sha256",
          "type": "string"
        },
        "dialect": {
          "const": "https://json-schema.org/draft/2020-12/schema",
          "default": "https://json-schema.org/draft/2020-12/schema",
          "title": "Dialect",
          "type": "string"
        },
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "id",
        "version",
        "content_sha256"
      ],
      "title": "DomainSchemaRef",
      "type": "object"
    },
    "DomainValidationResult": {
      "additionalProperties": false,
      "properties": {
        "errors": {
          "items": {
            "type": "string"
          },
          "title": "Errors",
          "type": "array"
        },
        "status": {
          "default": "not_validated",
          "enum": [
            "not_validated",
            "valid",
            "invalid",
            "unavailable"
