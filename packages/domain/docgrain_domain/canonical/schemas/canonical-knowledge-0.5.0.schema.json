          "type": "string"
        },
        "part": {
          "description": "DOCX package part, e.g. word/document.xml",
          "minLength": 1,
          "title": "Part",
          "type": "string"
        },
        "path": {
          "description": "Stable path within the package part",
          "minLength": 1,
