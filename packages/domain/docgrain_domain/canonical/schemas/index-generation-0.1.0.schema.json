{
  "$defs": {
    "ChunkContext": {
      "additionalProperties": false,
      "properties": {
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "kind": {
          "enum": [
            "document",
            "section",
            "list",
            "table_caption",
            "entity_label"
          ],
          "title": "Kind",
          "type": "string"
        },
        "object_ref": {
          "$ref": "#/$defs/ObjectRef"
        },
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "object_ref",
        "kind",
        "text"
      ],
      "title": "ChunkContext",
      "type": "object"
    },
    "ChunkOmission": {
      "additionalProperties": false,
      "properties": {
        "object_ref": {
          "$ref": "#/$defs/ObjectRef"
        },
        "reason": {
          "enum": [
            "empty_text",
            "no_description",
            "unaccepted_entity",
            "invalid_entity",
            "legacy_entity",
            "entity_disabled"
          ],
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "object_ref",
        "reason"
      ],
      "title": "ChunkOmission",
      "type": "object"
    },
    "ChunkPayload": {
      "additionalProperties": false,
      "properties": {
        "character_count": {
          "minimum": 1,
          "title": "Character Count",
          "type": "integer"
        },
        "content_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Sha256",
          "type": "string"
        },
        "context": {
          "items": {
            "$ref": "#/$defs/ChunkContext"
          },
          "title": "Context",
          "type": "array"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "kind": {
          "enum": [
            "text",
            "table",
            "entity",
            "description"
          ],
          "title": "Kind",
          "type": "string"
        },
        "object_ref": {
          "$ref": "#/$defs/ObjectRef"
        },
        "order": {
          "minimum": 0,
          "title": "Order",
          "type": "integer"
        },
        "ordinal": {
          "minimum": 0,
          "title": "Ordinal",
          "type": "integer"
        },
        "oversized": {
          "default": false,
          "title": "Oversized",
          "type": "boolean"
        },
        "parents": {
          "items": {
            "$ref": "#/$defs/ObjectRef"
          },
          "minItems": 1,
          "title": "Parents",
          "type": "array"
        },
        "retrieval_text": {
          "minLength": 1,
          "title": "Retrieval Text",
          "type": "string"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/ChunkSource"
          },
          "minItems": 1,
          "title": "Sources",
          "type": "array"
        },
        "split_fallback": {
          "default": false,
          "title": "Split Fallback",
          "type": "boolean"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "object_ref",
        "kind",
        "order",
        "ordinal",
        "text",
        "retrieval_text",
        "content_sha256",
        "character_count",
        "parents",
        "sources"
      ],
      "title": "ChunkPayload",
      "type": "object"
    },
    "ChunkSet": {
      "additionalProperties": false,
      "description": "Complete derivation, including a valid empty result; not a historical manifest.",
      "properties": {
        "chunk_omissions": {
          "items": {
            "$ref": "#/$defs/ChunkOmission"
          },
          "title": "Chunk Omissions",
          "type": "array"
        },
        "chunks": {
          "items": {
            "$ref": "#/$defs/ChunkPayload"
          },
          "title": "Chunks",
          "type": "array"
        },
        "revision": {
          "$ref": "#/$defs/DerivedRevision"
        }
      },
      "required": [
        "revision",
        "chunks",
        "chunk_omissions"
      ],
      "title": "ChunkSet",
      "type": "object"
    },
    "ChunkSource": {
      "additionalProperties": false,
      "properties": {
        "end": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "field_pointers": {
          "items": {
            "type": "string"
          },
          "title": "Field Pointers",
          "type": "array"
        },
        "kind": {
          "enum": [
            "whole",
            "text",
            "rows",
            "entity_fields"
          ],
          "title": "Kind",
          "type": "string"
        },
        "object_ref": {
          "$ref": "#/$defs/ObjectRef"
        },
        "start": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start"
        }
      },
      "required": [
        "object_ref",
        "kind"
      ],
      "title": "ChunkSource",
      "type": "object"
    },
    "ChunkingSpec": {
      "additionalProperties": false,
      "properties": {
        "budget_unit": {
          "const": "unicode-characters",
          "default": "unicode-characters",
          "title": "Budget Unit",
          "type": "string"
        },
        "include_entities": {
          "default": true,
          "title": "Include Entities",
          "type": "boolean"
        },
        "max_chars": {
          "default": 1600,
          "maximum": 32000,
          "minimum": 64,
          "title": "Max Chars",
          "type": "integer"
        },
        "max_table_rows": {
          "default": 20,
          "maximum": 1000,
          "minimum": 1,
          "title": "Max Table Rows",
          "type": "integer"
        },
        "strategy": {
          "const": "canonical-structure",
          "default": "canonical-structure",
          "title": "Strategy",
          "type": "string"
        },
        "strategy_version": {
          "const": "1",
          "default": "1",
          "title": "Strategy Version",
          "type": "string"
        },
        "table_header_rows": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Table Header Rows",
          "type": "object"
        }
      },
      "title": "ChunkingSpec",
      "type": "object"
    },
    "DerivedRevision": {
      "additionalProperties": false,
      "description": "Separate immutable chunking/embedding/indexing runs; no runtime backend types.",
      "properties": {
        "configuration": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Configuration",
          "type": "object"
        },
        "document_id": {
          "minLength": 1,
          "title": "Document Id",
          "type": "string"
        },
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "processing_revision_id": {
          "minLength": 1,
          "title": "Processing Revision Id",
          "type": "string"
        },
        "stage": {
          "enum": [
            "projection",
            "chunking",
            "embedding",
            "indexing"
          ],
          "title": "Stage",
          "type": "string"
        },
        "strategy": {
          "minLength": 1,
          "title": "Strategy",
          "type": "string"
        },
        "strategy_version": {
          "minLength": 1,
          "title": "Strategy Version",
          "type": "string"
        },
        "upstream_revision_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Upstream Revision Ids",
          "type": "array"
        },
        "workspace_id": {
          "minLength": 1,
          "title": "Workspace Id",
          "type": "string"
        }
      },
      "required": [
        "id",
        "workspace_id",
        "document_id",
        "processing_revision_id",
        "stage",
        "upstream_revision_ids",
        "strategy",
        "strategy_version"
      ],
      "title": "DerivedRevision",
      "type": "object"
    },
    "EmbeddingSpec": {
      "additionalProperties": false,
      "properties": {
        "dimensions": {
          "maximum": 65536,
          "minimum": 1,
          "title": "Dimensions",
          "type": "integer"
        },
        "model": {
          "minLength": 1,
          "title": "Model",
          "type": "string"
        },
        "options": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Options",
          "type": "object"
        },
        "provider": {
          "minLength": 1,
          "title": "Provider",
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "provider",
        "model",
        "version",
        "dimensions"
      ],
      "title": "EmbeddingSpec",
      "type": "object"
    },
    "IndexEntry": {
      "additionalProperties": false,
      "properties": {
        "chunk": {
          "$ref": "#/$defs/ChunkPayload"
        },
        "embedding_ref": {
          "$ref": "#/$defs/ObjectRef"
        },
        "index_ref": {
          "$ref": "#/$defs/ObjectRef"
        },
        "vector": {
          "items": {
            "type": "number"
          },
          "minItems": 1,
          "title": "Vector",
          "type": "array"
        }
      },
      "required": [
        "chunk",
        "embedding_ref",
        "index_ref",
        "vector"
      ],
      "title": "IndexEntry",
      "type": "object"
    },
    "IndexSpec": {
      "additionalProperties": false,
      "properties": {
        "chunking": {
          "$ref": "#/$defs/ChunkingSpec"
        },
        "embedding": {
          "$ref": "#/$defs/EmbeddingSpec"
        },
        "name": {
          "default": "default",
          "pattern": "^[A-Za-z0-9_-]{1,100}$",
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "embedding"
      ],
      "title": "IndexSpec",
      "type": "object"
    },
    "JsonValue": {},
    "ObjectRef": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "source",
            "processing",
            "canonical",
            "projection",
            "chunk",
            "embedding",
            "index"
          ],
          "title": "Kind",
          "type": "string"
        },
        "object_id": {
          "minLength": 1,
          "title": "Object Id",
          "type": "string"
        },
        "revision_id": {
          "minLength": 1,
          "title": "Revision Id",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "revision_id",
        "object_id"
      ],
      "title": "ObjectRef",
      "type": "object"
    }
  },
  "$id": "urn:docgrain:index-generation:0.1.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "base_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Base Id"
    },
    "chunk_set": {
      "$ref": "#/$defs/ChunkSet"
    },
    "embedded_chunk_ids": {
      "items": {
        "type": "string"
      },
      "title": "Embedded Chunk Ids",
      "type": "array"
    },
    "embedding_revision": {
      "$ref": "#/$defs/DerivedRevision"
    },
    "entries": {
      "items": {
        "$ref": "#/$defs/IndexEntry"
      },
      "title": "Entries",
      "type": "array"
    },
    "full": {
      "default": false,
      "title": "Full",
      "type": "boolean"
    },
    "removed_chunk_ids": {
      "items": {
        "type": "string"
      },
      "title": "Removed Chunk Ids",
      "type": "array"
    },
    "reused_chunk_ids": {
      "items": {
        "type": "string"
      },
      "title": "Reused Chunk Ids",
      "type": "array"
    },
    "revision": {
      "$ref": "#/$defs/DerivedRevision"
    },
    "schema_version": {
      "const": "0.1.0",
      "default": "0.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "spec": {
      "$ref": "#/$defs/IndexSpec"
    }
  },
  "required": [
    "spec",
    "base_id",
    "chunk_set",
    "embedding_revision",
    "revision",
    "entries",
    "embedded_chunk_ids",
    "reused_chunk_ids",
    "removed_chunk_ids"
  ],
  "title": "IndexGeneration",
  "type": "object"
}
