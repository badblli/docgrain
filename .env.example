# Environment
DOCGRAIN_ENV=development
DOCGRAIN_LOG_LEVEL=INFO
# false: live PostgreSQL/storage; true: read-only synthetic demo, no uploads
USE_FIXTURES=false

# Database and queue
POSTGRES_DB=docgrain
POSTGRES_USER=docgrain
POSTGRES_PASSWORD=change-me-locally
DATABASE_URL=postgresql+psycopg://docgrain:change-me-locally@postgres:5432/docgrain
REDIS_URL=redis://redis:6379/0

# Object storage (MinIO in local compose)
S3_ENDPOINT_URL=http://minio:9000
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=docgrain
S3_ACCESS_KEY=docgrain
S3_SECRET_KEY=change-me-locally
API_PUBLIC_URL=http://localhost:8000

# Current PDF extraction: key set = Gemini primary; blank = Docling with OCR disabled.
# Target Docling-primary enrichment architecture is not implemented yet.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
# Deferred; no Qwen adapter exists.
QWEN_BASE_URL=
# Infrastructure only; embedding/index adapter is not implemented.
QDRANT_URL=http://qdrant:6333
