# Environment
DOCGRAIN_ENV=development
DOCGRAIN_LOG_LEVEL=INFO
# false: live PostgreSQL/storage; true: read-only synthetic demo, no uploads
USE_FIXTURES=false

# Database and queue
POSTGRES_DB=docgrain
POSTGRES_USER=docgrain
POSTGRES_PASSWORD=change-me-locally
DATABASE_URL=postgresql+psycopg://docgrain:change-me-locally@postgres:5432/docgrain
REDIS_URL=redis://redis:6379/0

# Object storage (MinIO in local compose)
S3_ENDPOINT_URL=http://minio:9000
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=docgrain
S3_ACCESS_KEY=docgrain
S3_SECRET_KEY=change-me-locally
API_PUBLIC_URL=http://localhost:8000

# Canonical structure: Docling + pinned local TR/EN EasyOCR (CPU), scores require review.
DOCGRAIN_OCR_ENABLED=true
DOCGRAIN_NATIVE_FIDELITY_ENABLED=true
# Image ships checkpoints; change path only to an equally verified local directory.
DOCGRAIN_OCR_MODEL_DIR=/opt/docgrain/easyocr
# Remote legacy page extraction requires explicit opt-in as well as a key.
DOCGRAIN_REMOTE_VISION_ENABLED=false
# Selected remote proposals also require the runner's --allow-remote switch.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
# Deferred; no Qwen adapter exists.
QWEN_BASE_URL=
# Infrastructure only; embedding/index adapter is not implemented.
QDRANT_URL=http://qdrant:6333

# Local browser-to-API configuration (baked into the web image at build time)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WORKSPACE_ID=ws_local

# Experimental chat: explicit per-question consent; normalization remains local.
GEMINI_CHAT_ENABLED=false
